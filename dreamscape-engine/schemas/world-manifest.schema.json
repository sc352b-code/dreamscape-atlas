{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamscape.local/schemas/world-manifest.schema.json",
  "title": "Dreamscape World Engine v1 World Manifest",
  "type": "object",
  "required": ["engineVersion","worldId","title","version","status","privacy","corpus","runtimeScene","territories"],
  "properties": {
    "engineVersion": {"type":"string"},
    "worldId": {"type":"string","minLength":1},
    "title": {"type":"string","minLength":1},
    "version": {"type":"string","minLength":1},
    "status": {"type":"string"},
    "privacy": {
      "type":"object",
      "required":["runtimeClassification","rawCorpusPublic","identifiableSourceMaterialPublic"],
      "properties": {
        "runtimeClassification":{"type":"string"},
        "rawCorpusPublic":{"const":false},
        "identifiableSourceMaterialPublic":{"const":false}
      },
      "additionalProperties":true
    },
    "corpus": {
      "type":"object",
      "required":["totalDreams"],
      "properties":{"totalDreams":{"type":"integer","minimum":0},"sourceLabel":{"type":"string"}},
      "additionalProperties":true
    },
    "runtimeScene":{"type":"string"},
    "territories": {
      "type":"array",
      "minItems":1,
      "items": {
        "type":"object",
        "required":["id","name","subtitle","meaning","planetTexture","planetTextureSha256","approved","associationCountStatus","palette","geography","flatMap"],
        "properties": {
          "id":{"type":"string","minLength":1},
          "name":{"type":"string","minLength":1},
          "subtitle":{"type":"string","minLength":1},
          "meaning":{"type":"string","minLength":1},
          "planetTexture":{"type":"string","pattern":"^/assets/territory-planets/.+-final\\.png$"},
          "planetTextureSha256":{"type":"string","pattern":"^[0-9a-f]{64}$"},
          "approved":{"type":"boolean"},
          "associationCount":{"type":["integer","null"],"minimum":0},
          "associationCountStatus":{"enum":["known","unknown"]},
          "palette":{"type":"array","minItems":1,"items":{"type":"string"}},
          "geography":{"type":"array","minItems":1,"items":{"type":"string"}},
          "flatMap": {
            "type":"object",
            "required":["status","keyPlaces"],
            "properties":{"status":{"type":"string"},"keyPlaces":{"type":"array","items":{"type":"string"}}},
            "additionalProperties":true
          }
        },
        "additionalProperties":true
      }
    }
  },
  "additionalProperties":true
}
