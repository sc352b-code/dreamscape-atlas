{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://dreamscape.local/schemas/symbol.schema.json",
  "title": "Dreamscape Territory Symbol",
  "type": "object",
  "additionalProperties": false,
  "required": ["id", "name", "summary", "map", "corpusEvidence", "tarotCardRef", "interaction"],
  "properties": {
    "id": {"type": "string", "pattern": "^[a-z0-9-]+$"},
    "name": {"type": "string", "minLength": 1},
    "summary": {"type": "string", "minLength": 1},
    "map": {
      "type": "object",
      "additionalProperties": false,
      "required": ["placements", "visibleFromZoom"],
      "properties": {
        "placements": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "additionalProperties": false,
            "required": ["x", "y", "hitRadius"],
            "properties": {
              "x": {"type": "number", "minimum": 0, "maximum": 1},
              "y": {"type": "number", "minimum": 0, "maximum": 1},
              "hitRadius": {"type": "number", "exclusiveMinimum": 0},
              "artCue": {"type": "string"}
            }
          }
        },
        "visibleFromZoom": {"type": "number", "minimum": 0}
      }
    },
    "corpusEvidence": {
      "type": "object",
      "additionalProperties": false,
      "required": ["privacyClass", "summary", "evidenceRefs", "associationStatus"],
      "properties": {
        "privacyClass": {"enum": ["private-derived", "public-safe-derived"]},
        "summary": {"type": "string", "minLength": 1},
        "evidenceRefs": {"type": "array", "items": {"type": "string"}, "uniqueItems": true},
        "frequency": {"type": ["integer", "null"], "minimum": 0},
        "frequencyStatus": {"enum": ["known", "unknown", "not-published"]},
        "associationStatus": {"enum": ["territory-specific", "cross-territory", "uncertain"]},
        "relatedPlaceIds": {"type": "array", "items": {"type": "string"}, "uniqueItems": true}
      }
    },
    "tarotCardRef": {"type": "string", "minLength": 1},
    "interaction": {
      "type": "object",
      "additionalProperties": false,
      "required": ["hoverable", "clickable"],
      "properties": {
        "hoverable": {"type": "boolean"},
        "clickable": {"type": "boolean"},
        "hoverLabel": {"type": "boolean"}
      }
    }
  }
}
